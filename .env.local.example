# You normally don't edit this by hand: `npm run setup` writes .env.local for you.
# Copy to .env.local only if you're wiring up an existing project manually.
# The game runs without these (built-in demo items), but you need a project to
# forge your own items.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Each player's clone: full HTTPS URL to the organizer's deployed route.
# NEXT_PUBLIC_COMMUNITY_URL=https://your-calendar.vercel.app/api/community

# Organizer's Vercel deployment ONLY: never give the shared write token to players.
# Reads also go through the organizer server, even for public datasets.
# COMMUNITY_SANITY_PROJECT_ID=
# COMMUNITY_SANITY_DATASET=production
# COMMUNITY_SANITY_TOKEN=
# COMMUNITY_WRITES_ENABLED=1
# COMMUNITY_ALLOWED_ORIGINS=https://your-codespace.example
